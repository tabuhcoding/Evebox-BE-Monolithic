// Auth Service
generator client {
  provider = "prisma-client-js"
  output = "../../../../../prisma/client-booking"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_BOOKING")
}

// Booking Service

model Order {
  id             Int  @id @default(@autoincrement())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now())
  showingId      String
  formResponseId Int?
  type           BookingTicketType
  price          Int
  totalPrice     Int
  userId         String
  status         BookingTicketStatus
  mailSent       Boolean        @default(false)
  paymentId      Int?
  voucherCodeId  String?
  Ticket         Ticket[]
}

model Ticket {
  id           String  @id @default(uuid())
  qrCode       String?
  description  String
  seatId       Int?
  orderId      String
  ticketTypeId String?
  sectionId    Int?
  isCheckedIn  Boolean @default(false)
  checkedBy    String  @default("")
  Order        Order   @relation(fields: [orderId], references: [id])
}

enum BookingTicketType{
  PHYSICAL_TICKET
  E_TICKET
}

enum BookingTicketStatus{
  CANCEL
  SUCCESS
  PENDING
  PAID
}
