// Auth Service
generator client {
  provider = "prisma-client-js"
  output = "../../../../../prisma/client-auth"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_AUTH")
}

model Role {
  id        Int    @id
  role_name String @db.VarChar(50)
  users     User[]

  @@map("role")
}

model User {
  id                    String                  @id @db.VarChar(255)
  name                  String                  @db.VarChar(255)
  email                 String                  @unique @db.VarChar(255)
  phone                 String                  @db.VarChar(10)
  password              String                  @db.VarChar(255)
  role_id               Int?
  created_at            DateTime                @default(now())
  receiveNoti           Boolean                 @default(false)
  avatar_id             Int?   
  status                UserStatus     @default(ACTIVE)
  images                Images[]                 @relation("UserUploadedImages") 
  avatar                Images?                  @relation("UserAvatar", fields: [avatar_id], references: [id])
  refreshTokens         RefreshToken[]
  role                  Role?                   @relation(fields: [role_id], references: [id])
  favoriteNotiHistory   FavoriteNotiHistory[]   @relation("UserFavoriteHistory")
  userPin             UserPin?
  totalEvents          Int?                     
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  email     String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserPin {
  id         Int      @id @default(autoincrement())
  userEmail     String      @unique @db.VarChar(255)
  user       User     @relation(fields: [userEmail], references: [email])
  hashedPin  String
  attempts   Int      @default(0)
  lockedUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Otp {
  id           String   @id
  email        String
  otp          String
  type         OTPType
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  attempts     Int
  requestToken String   @unique

  @@index([email])
  @@index([otp])
  @@map("otps")
}

model Images {
  id         Int      @id @default(autoincrement())
  userId     String?  @default("TicketBox")
  imageUrl   String   @db.VarChar(255)
  createdAt  DateTime @default(now())
  user       User?     @relation("UserUploadedImages",fields: [userId], references: [email], onDelete: Cascade)
  avatarUser User[]   @relation("UserAvatar")
}

model FavoriteNotiHistory {
  id          String   @id @default(uuid())
  userId      String
  itemType    ItemType
  orgId       String?
  eventId     Int?
  isFavorite  Boolean
  isNotified  Boolean

  user        User       @relation("UserFavoriteHistory", fields: [userId], references: [email])
}

model Revenue {
  id Int @id @default(autoincrement())
  date DateTime
  total_revenue Int @default(0)

  OrganizeRevenue OrganizeRevenue[]
}

model OrganizeRevenue {
  id Int @id @default(autoincrement())
  date DateTime?
  revenue_id Int
  org_id String
  org_name String?
  total_revenue Int @default(0)

  Revenue Revenue @relation(fields: [revenue_id], references: [id])
  EventRevenue EventRevenue[]
}

model EventRevenue {
  id Int @id @default(autoincrement())
  date DateTime?
  org_id Int
  event_id Int
  event_name String?
  total_revenue Int

  OrganizerRevenue OrganizeRevenue @relation(fields: [org_id], references: [id])
  ShowingRevenue ShowingRevenue[]
}

model ShowingRevenue{
  id Int @id @default(autoincrement())
  date DateTime?
  event_id Int
  showing_id String
  start_date DateTime
  end_date DateTime
  total_revenue Int

  EventRevenue EventRevenue @relation(fields: [event_id], references: [id])
  TicketTypeRevenue TicketTypeRevenue[]
}

model TicketTypeRevenue{
  id Int @id @default(autoincrement())
  date DateTime?
  showing_id Int
  ticket_type_id String
  name String?
  price Int
  sold Int @default(0)
  total_revenue Int

  ShowingRevenue ShowingRevenue @relation(fields: [showing_id], references: [id])
}

enum OTPType {
  FORGOT_PASSWORD
  REGISTER
}

enum ItemType {
  EVENT
  ORG
}


enum UserStatus {
ACTIVE
BLOCKED
}

